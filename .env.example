# Template only — safe to commit because it holds no real values.
# Copy to .env and fill in:  cp .env.example .env
# .env itself is gitignored and must never be committed.

# Your Zammad instance root, including scheme, with no trailing slash
# and no /api/v1 suffix (the client appends that itself).
ZAMMAD_URL=https://your-instance.zammad.com

# Zammad UI: avatar (top left) → Profile → Token Access → Create.
# Phase 1 is read-only, so ticket.agent read permission is enough.
# Shown exactly once at creation — if you lose it, delete and make a new one.
ZAMMAD_TOKEN=

# --- LLM provider -----------------------------------------------------------
# Any OpenAI-compatible chat completions API. Switching provider means changing
# these three values only — no code change.
#
#   local Ollama : http://localhost:11434/v1   key "ollama"   model qwen2.5:7b
#   DeepSeek     : https://api.deepseek.com/v1 key sk-...     model deepseek-chat
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
